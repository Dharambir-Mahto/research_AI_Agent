# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Voice Live Model (Must support bidiGenerateContent)
# Options:
# - gemini-2.5-flash-native-audio-latest (Recommended low-latency native audio)
# - gemini-3.8-live
# - gemini-3.1-flash-live-preview
GEMINI_VOICE_MODEL=demo_model

# Gemini Voice Persona (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE_NAME=demo_persona

# Optional Neo4j Knowledge Graph Configuration
NEO4J_URL=demo_url
NEO4J_USERNAME=demo_username
NEO4J_PASSWORD=demo_password
